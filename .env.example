# Secco.Intranet — variáveis de ambiente de desenvolvimento.
#
# Copie para .env e ajuste os valores. O .env real nunca entra no git.
#   cp .env.example .env
#
# Quem lê este arquivo:
#   docker compose  — automaticamente, para interpolar o docker-compose.yml, e o serviço
#                     intranet-web o recebe inteiro como ambiente, menos as senhas de SQL e o PAT
#   VS Code (F5)    — via "envFile" em .vscode/launch.json
#   scripts/dev.ps1 e scripts/dev.sh — para subir a aplicação pelo terminal

# ---------------------------------------------------------------------------
# SQL Server de desenvolvimento (docker-compose.yml)
# ---------------------------------------------------------------------------

# Senha do usuário sa. Usado só pelo container subir e pelo serviço sqlserver-init
# provisionar o banco do tenant (ver docker/init/provision-tenant-db.sql) — a aplicação
# nunca usa sa (ADR-0007). Aspas simples por padrão em segredo: a política do SQL Server
# exige símbolo, e # $ ! ou espaço no valor quebram o parser quando sem aspas.
MSSQL_SA_PASSWORD='TroqueEstaSenha#2026'

# Senha do login de aplicação que o sqlserver-init cria, com db_owner só no banco do
# tenant "alfa" (intranet_alfa) — nada no servidor. É essa credencial, não sa, que
# entra na connection string abaixo. Mesmas regras de símbolo/aspas da senha do sa.
MSSQL_APP_PASSWORD='TrocaEstaTambem#2026'

# Porta publicada no host. Mudou aqui? Ajuste a porta da connection string abaixo também.
MSSQL_PORT=1433

# ---------------------------------------------------------------------------
# Aplicação em container (serviço intranet-web)
# ---------------------------------------------------------------------------

# PAT do GitHub com read:packages, para o restore do feed privado no build da imagem. Entra só
# como BuildKit secret. Vazio, o build falha no restore com NU1301 e 401 (Unauthorized);
# docker compose up -d sqlserver-init continua subindo só o SQL, sem build.
NUGET_PAT=

# Porta publicada no host. Diferente de 5250/7250 do dotnet run, para os dois não colidirem.
INTRANET_PORT=8080

# Só em Linux, para quem usa também dotnet run: o seu uid (id -u), para o container e o dotnet
# run gravarem nas mesmas pastas de .dados/. Em Windows, o padrão (1654) basta.
# INTRANET_UID=1000

# ---------------------------------------------------------------------------
# Catálogo de tenants da aplicação (ADR-0005)
# ---------------------------------------------------------------------------
#
# O nome mapeia para a chave de configuração Secco:Tenancy:Tenants:<id>:ConnectionString
# — no provider de variáveis de ambiente do ASP.NET Core, __ vira :. O <id> é o mesmo
# GUID de Intranet:Development:TenantId em appsettings.Development.json.
#
# ATENÇÃO: o nome carrega os hífens do GUID, então esta linha NÃO pode ser lida com
# `set -a; . ./.env` — hífen não é nome de variável válido no shell. Docker Compose e o
# envFile do VS Code leem sem problema.
#
# User Id e Password aqui são o login de aplicação (MSSQL_APP_PASSWORD acima), não sa.
Secco__Tenancy__Tenants__018f0000-0000-7000-8000-000000000001__ConnectionString='Server=localhost,1433;Database=intranet_alfa;User Id=intranet_alfa_app;Password=TrocaEstaTambem#2026;TrustServerCertificate=true'
