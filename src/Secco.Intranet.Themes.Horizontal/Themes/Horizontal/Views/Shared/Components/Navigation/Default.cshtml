@model NavigationModel
<ul class="sc-nav">
    @foreach (var grupo in Model.Grupos)
    {
        if (grupo.Itens.Count == 0)
        {
            continue;
        }

        if (grupo.Titulo is not null)
        {
            <li class="sc-nav__divider" aria-hidden="true"></li>
            <li class="sc-nav__group-title" aria-hidden="true">@grupo.Titulo</li>
        }

        foreach (var item in grupo.Itens)
        {
            var temSetor = !string.IsNullOrWhiteSpace(item.SetorSlug);
            string? estilo = temSetor ? $"--sc-setor-hue:{SetorHue.From(item.SetorSlug)}" : null;

            <li>
                <a class="sc-nav__item @(item.Ativo ? "is-active" : null)"
                   href="@item.Url"
                   style="@estilo"
                   aria-current="@(item.Ativo ? "page" : null)">
                    @* O icone do setor herda o matiz dele: a cor continua dizendo de quem e
                       o item, e o glifo passa a dizer o que e. *@
                    <i class="bi @item.Icone sc-nav__icon @(temSetor ? "sc-nav__icon--setor" : null)"
                       aria-hidden="true"></i>
                    <span class="sc-nav__label">@item.Texto</span>
                </a>
            </li>
        }
    }
</ul>
