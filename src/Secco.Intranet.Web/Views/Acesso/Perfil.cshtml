@model PerfilViewModel
@{
    var tela = Model.Tela;
    var perfil = tela.Perfil;

    ViewData["Title"] = perfil.Nome;

    var cabecalho = new PageHeaderModel(
        perfil.Nome,
        perfil.Implicito
            ? "Todo membro ativo do tenant tem este perfil, sem atribuição, inclusive quem entrar depois. Marque o que todos podem fazer."
            : "Marque as permissões deste perfil.",
        Acoes: new[] { new PageActionModel("Voltar", Url.Action("Index")!, "bi-arrow-left") });

    var catalogoDePermissoes = IntranetPermissoes.Catalogo.ToList();
    var doSetor = ClassificacaoDePerfil.DoSetor(perfil.Nome);

    if (doSetor is not null)
    {
        catalogoDePermissoes.Insert(0, IntranetPermissoes.Setor.Write(doSetor.Value.Slug));
        catalogoDePermissoes.Insert(0, IntranetPermissoes.Setor.Read(doSetor.Value.Slug));
    }

    // Uma permissão que o perfil já tem e não está no catálogo (legado, ou atribuída fora desta
    // tela) precisa continuar aparecendo — senão salvar o formulário a apagaria sem o admin ver.
    // As das bibliotecas ativas já saem na seção própria, então não repetem aqui; as das inativas
    // seguem como extras.
    var mostradasNaSecao = Model.Bibliotecas
        .SelectMany(b => new[] { IntranetPermissoes.Biblioteca.Read(b.Slug), IntranetPermissoes.Biblioteca.Write(b.Slug) })
        .ToHashSet(StringComparer.Ordinal);

    foreach (var extra in perfil.Permissoes.Where(p => !catalogoDePermissoes.Contains(p) && !mostradasNaSecao.Contains(p)))
    {
        catalogoDePermissoes.Add(extra);
    }

    var permissoesAtuais = perfil.Permissoes.ToHashSet(StringComparer.Ordinal);
    var descricoes = IntranetPermissoes.Catalog.ToDictionary(p => p.Name, p => p.Description, StringComparer.Ordinal);

    string? PaginaUrl(int pagina) => Url.Action("Perfil", new { nome = perfil.Nome, page = pagina });

    var paginacao = new PaginationModel(
        tela.Membros.Pagina,
        tela.Membros.TotalDePaginas,
        tela.Membros.Pagina > 1 ? PaginaUrl(tela.Membros.Pagina - 1) : null,
        tela.Membros.Pagina < tela.Membros.TotalDePaginas ? PaginaUrl(tela.Membros.Pagina + 1) : null);

    static BadgeModel BadgeDaSituacao(SituacaoDoUsuario situacao) => situacao switch
    {
        SituacaoDoUsuario.Ativo => new BadgeModel("Ativo", BadgeVariante.Sucesso),
        SituacaoDoUsuario.Desativado => new BadgeModel("Desativado", BadgeVariante.Perigo),
        SituacaoDoUsuario.Bloqueado => new BadgeModel("Bloqueado", BadgeVariante.Aviso),
        _ => new BadgeModel("Desconhecida", BadgeVariante.Neutro),
    };

    var podeExcluir = perfil.Tipo == TipoDePerfil.Comum && !perfil.Reservado && !perfil.Implicito;
}

<partial name="_PageHeader" model="cabecalho" />

<div class="sc-panel">
    <h2 class="h6">Permissões</h2>
    @if (perfil.Reservado)
    {
        <p class="text-muted mb-0">Perfil reservado da plataforma — permissões não editáveis por aqui.</p>
    }
    else
    {
        <form method="post" asp-action="EditarPermissoes">
            <input type="hidden" name="nome" value="@perfil.Nome" />
            @foreach (var permissao in catalogoDePermissoes)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="permissoes" value="@permissao" id="perm-@permissao" checked="@permissoesAtuais.Contains(permissao)" />
                    <label class="form-check-label" for="perm-@permissao">@descricoes.GetValueOrDefault(permissao) <span class="sc-meta">@permissao</span></label>
                </div>
            }
            @if (Model.Bibliotecas.Count > 0)
            {
                <h3 class="h6 mt-3">Bibliotecas</h3>
                @foreach (var biblioteca in Model.Bibliotecas)
                {
                    var ler = IntranetPermissoes.Biblioteca.Read(biblioteca.Slug);
                    var alterar = IntranetPermissoes.Biblioteca.Write(biblioteca.Slug);
                    <div class="mb-2">
                        <div>@biblioteca.Nome <span class="sc-meta">@biblioteca.Slug</span></div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="permissoes" value="@ler" id="perm-@ler" checked="@permissoesAtuais.Contains(ler)" />
                            <label class="form-check-label" for="perm-@ler">Ler</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="permissoes" value="@alterar" id="perm-@alterar" checked="@permissoesAtuais.Contains(alterar)" />
                            <label class="form-check-label" for="perm-@alterar">Alterar (inclui ler)</label>
                        </div>
                    </div>
                }
            }
            <button class="btn btn-outline-primary mt-2" type="submit">Salvar permissões</button>
        </form>
    }
</div>

<div class="sc-panel mt-3">
    @if (perfil.Implicito)
    {
        <h2 class="h6">Membros</h2>
        <p class="text-muted mb-0">Todos os membros ativos do tenant. Ninguém é adicionado nem retirado por aqui.</p>
    }
    else
    {
        <h2 class="h6">Membros (@perfil.TotalDeMembros)</h2>

        @if (tela.Membros.Itens.Count == 0)
        {
            <partial name="_EmptyState" model="@(new EmptyStateModel("bi-people", "Ninguém tem este perfil ainda"))" />
        }
        else
        {
            <ul class="sc-list">
                @foreach (var membro in tela.Membros.Itens)
                {
                    <li class="sc-list__item">
                        <div class="sc-list__text">
                            <p class="sc-list__title">
                                <a class="text-reset text-decoration-none" asp-action="Usuario" asp-route-id="@membro.UsuarioId">@(string.IsNullOrWhiteSpace(membro.Email) ? "(sem e-mail)" : membro.Email)</a>
                            </p>
                            <span class="sc-list__sub"><partial name="_Badge" model="BadgeDaSituacao(membro.Situacao)" /></span>
                        </div>
                        <form method="post" asp-action="RetirarPerfil" class="d-inline">
                            <input type="hidden" name="usuarioId" value="@membro.UsuarioId" />
                            <input type="hidden" name="perfil" value="@perfil.Nome" />
                            <input type="hidden" name="origem" value="perfil" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Retirar</button>
                        </form>
                    </li>
                }
            </ul>

            <partial name="_Pagination" model="paginacao" />
        }
    }
</div>

@if (!perfil.Reservado && !perfil.Implicito)
{
    <div class="sc-panel mt-3">
        @if (tela.Candidatos.Count == 0)
        {
            <p class="text-muted mb-0">Todo usuário ativo já tem este perfil.</p>
        }
        else
        {
            <form method="post" asp-action="AtribuirPerfil" class="d-flex flex-wrap gap-2 align-items-end">
                <input type="hidden" name="perfil" value="@perfil.Nome" />
                <input type="hidden" name="origem" value="perfil" />
                <div class="sc-form__field mb-0">
                    <label class="form-label" for="usuarioId">Adicionar membro</label>
                    <select class="form-select" id="usuarioId" name="usuarioId" required>
                        <option value="">Escolha um usuário</option>
                        @foreach (var candidato in tela.Candidatos)
                        {
                            <option value="@candidato.Id">@(string.IsNullOrWhiteSpace(candidato.Email) ? candidato.Id.ToString() : candidato.Email)</option>
                        }
                    </select>
                </div>
                <button class="btn btn-outline-primary" type="submit">Adicionar</button>
            </form>
        }
    </div>
}

@if (podeExcluir)
{
    <div class="sc-panel mt-3">
        <form method="post" asp-action="ExcluirPerfil" data-confirmar="Excluir o perfil &quot;@perfil.Nome&quot;? Não dá para desfazer.">
            <input type="hidden" name="nome" value="@perfil.Nome" />
            <button class="btn btn-outline-danger" type="submit">Excluir perfil</button>
            <div class="form-text">Só é possível quando o perfil não tem membros.</div>
        </form>
    </div>
}
