@using System.Globalization
@model IReadOnlyList<Secco.Intranet.Application.Salas.ReservaDto>
@{
	ViewData["Title"] = "Minhas reservas";

	var invariante = CultureInfo.InvariantCulture;

	var cabecalho = new PageHeaderModel(
		"Minhas reservas",
		"As próximas reservas que você fez ou para as quais foi convidado.",
		Acoes: new[] { new PageActionModel("Ver a grade", Url.Action("Index")!, "bi-grid-3x3-gap") });

	var vazio = new EmptyStateModel(
		"bi-calendar-check",
		"Nenhuma reserva à vista",
		"Você não tem reservas futuras nem convites.",
		new PageActionModel("Reservar uma sala", Url.Action("Reservar")!, "bi-plus-lg", Primaria: true));
}

<partial name="_PageHeader" model="cabecalho" />

@if (Model.Count == 0)
{
	<partial name="_EmptyState" model="vazio" />
}
else
{
	<div class="sc-panel">
		<table class="table table-sm align-middle mb-0">
			<thead>
				<tr>
					<th>Dia</th>
					<th>Horário</th>
					<th>Sala</th>
					<th>Título</th>
					<th>Reservado por</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var reserva in Model)
				{
					<tr>
						<td>@Formato.Data(reserva.Dia)</td>
						<td>@reserva.Inicio.ToString("HH:mm", invariante) &ndash; @reserva.Fim.ToString("HH:mm", invariante)</td>
						<td>@reserva.SalaNome</td>
						<td><a asp-action="Reserva" asp-route-id="@reserva.Id">@reserva.Titulo</a></td>
						<td>@reserva.ReservadoPor.Nome</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
