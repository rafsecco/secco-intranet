@using Secco.Intranet.Web.Models.Bibliotecas
@model BibliotecaFormViewModel
@{
    ViewData["Title"] = $"Editar {Model.Nome}";

    var cabecalho = new PageHeaderModel(
        $"Editar {Model.Nome}",
        "Nome, ícone e situação. O slug não muda.",
        Model.Slug);
}

<partial name="_PageHeader" model="cabecalho" />

<div class="sc-panel sc-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <form method="post" asp-action="Editar" asp-route-id="@Model.Id">
        <input type="hidden" asp-for="Id" />
        @* Campo desabilitado nao e enviado no POST; o hidden preserva o slug quando o
           formulario volta com erro de validacao. *@
        <input type="hidden" asp-for="Slug" />

        <div class="sc-form__field">
            <label class="form-label" asp-for="Nome">Nome</label>
            <input class="form-control" asp-for="Nome" autocomplete="off" />
            <span class="text-danger" asp-validation-for="Nome"></span>
        </div>

        <div class="sc-form__field">
            <label class="form-label" for="slug-somente-leitura">Slug</label>
            <input class="form-control font-monospace" id="slug-somente-leitura" value="@Model.Slug" disabled />
            <div class="form-text">
                O slug é o endereço da biblioteca e a base das permissões <code>biblioteca-@(Model.Slug):read</code> e
                <code>biblioteca-@(Model.Slug):write</code>. Por isso ele não é editável.
            </div>
        </div>

        <div class="sc-form__field">
            <label class="form-label" asp-for="Icone">Ícone</label>
            <input class="form-control font-monospace" asp-for="Icone" autocomplete="off"
                   placeholder="bi-journal-text" />
            <div class="form-text">
                Classe do <a href="https://icons.getbootstrap.com/" target="_blank" rel="noopener">Bootstrap Icons</a>,
                como <code>bi-journal-text</code>. Em branco usa o ícone padrão.
            </div>
            <span class="text-danger" asp-validation-for="Icone"></span>
        </div>

        <div class="form-check">
            <input class="form-check-input" asp-for="Ativo" />
            <label class="form-check-label" asp-for="Ativo">Biblioteca ativa</label>
            <div class="form-text">Biblioteca inativa some para quem lê; os documentos continuam guardados.</div>
        </div>

        <div class="sc-form__actions">
            <button class="btn btn-primary" type="submit">Salvar biblioteca</button>
            <a class="btn btn-outline-secondary" href="/bibliotecas">Cancelar</a>
        </div>
    </form>
</div>
