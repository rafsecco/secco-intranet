@using Secco.Intranet.Web.Models.Diretorio
@model EnviarFotoViewModel

<section class="sc-panel mb-3" data-recorte-foto>
    <h2 class="h6">Foto</h2>

    <form method="post" action="@Model.AcaoEnviar" enctype="multipart/form-data" data-recorte-foto-form>
        @Html.AntiForgeryToken()
        <input type="hidden" name="x" />
        <input type="hidden" name="y" />
        <input type="hidden" name="largura" />
        <input type="hidden" name="altura" />

        <div class="sc-form__field">
            <label class="form-label" for="foto">Enviar uma foto</label>
            <input class="form-control" type="file" id="foto" name="foto" accept="image/jpeg,image/png,image/webp" />
            <div class="form-text">JPEG, PNG ou WebP, até 10 MB. A foto é reduzida e guardada sem os dados do arquivo original (como a localização).</div>
        </div>

        <div class="sc-recorte-foto mb-3" style="max-width: 480px" data-recorte-foto-area hidden>
            <img alt="Pré-visualização para recorte" class="d-block mw-100" data-recorte-foto-imagem />
        </div>

        <button class="btn btn-primary" type="submit">Enviar foto</button>
    </form>

    @if (Model.TemFoto)
    {
        <form method="post" action="@Model.AcaoRemover" class="mt-2" data-confirmar="Remover a foto? A tela volta a mostrar as iniciais.">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-danger btn-sm" type="submit">Remover foto</button>
        </form>
    }
</section>
