@using Secco.Intranet.Application.Documentos
@using Secco.Intranet.Domain
@using Secco.Intranet.Domain.Documentos
@using Secco.Intranet.Web.Models.Documentos
@model SetorDocumentosViewModel
@{
    ViewData["Title"] = Model.Setor.Nome;

    var cabecalho = new PageHeaderModel(
        Model.Setor.Nome,
        "Documentos publicados por este setor.",
        Model.Setor.Slug);

    var vazio = new EmptyStateModel(
        "bi-folder2-open",
        "Nenhum documento publicado",
        Model.PodePublicar
            ? "Envie o primeiro arquivo pelo formulário acima."
            : "Quando o setor publicar algum documento, ele aparece aqui.");

    static string Tamanho(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024d:0.#} KB",
        _ => $"{bytes / (1024d * 1024d):0.#} MB",
    };
}

<partial name="_PageHeader" model="cabecalho" />

<nav class="sc-tabs" aria-label="Recursos do setor">
    <a class="sc-tabs__item is-active" asp-action="Documentos" asp-route-slug="@Model.Setor.Slug" aria-current="page">Documentos</a>
    <a class="sc-tabs__item" asp-action="Avisos" asp-route-slug="@Model.Setor.Slug">Avisos</a>
</nav>

@if (Model.PodePublicar)
{
    <div class="sc-panel mb-3">
        <h2 class="h6 mb-3">Publicar documento</h2>

        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <form method="post" asp-action="Publicar" asp-route-slug="@Model.Setor.Slug" enctype="multipart/form-data">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" asp-for="Form.Titulo">Título</label>
                    <input class="form-control" asp-for="Form.Titulo" autocomplete="off" />
                    <span class="text-danger" asp-validation-for="Form.Titulo"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="arquivo">Arquivo</label>
                    <input class="form-control" type="file" id="arquivo" name="arquivo" required />
                    <div class="form-text">Até @(Model.TamanhoMaximoBytes / (1024 * 1024)) MB. PDF, imagem, Office, texto ou ZIP.</div>
                </div>

                <div class="col-md-8">
                    <label class="form-label" asp-for="Form.Descricao">Descrição</label>
                    <input class="form-control" asp-for="Form.Descricao" autocomplete="off" />
                </div>

                <div class="col-md-4">
                    <label class="form-label" asp-for="Form.Visibilidade">Quem pode ver</label>
                    <select class="form-select" asp-for="Form.Visibilidade">
                        <option value="@((int)Visibilidade.Setor)">Somente este setor</option>
                        <option value="@((int)Visibilidade.Empresa)">Toda a empresa</option>
                    </select>
                </div>
            </div>

            <div class="sc-form__actions">
                <button class="btn btn-primary" type="submit">Publicar documento</button>
            </div>
        </form>
    </div>
}

@if (Model.Documentos.Count == 0)
{
    <partial name="_EmptyState" model="vazio" />
}
else
{
    <ul class="sc-list">
        @foreach (var documento in Model.Documentos)
        {
            var badge = documento.Visibilidade == Visibilidade.Empresa
                ? new BadgeModel("Toda a empresa", BadgeVariante.Neutro)
                : new BadgeModel(documento.SetorNome, BadgeVariante.Setor, documento.SetorSlug);

            <li class="sc-list__item" style="--sc-setor-hue:@SetorHue.From(documento.SetorSlug)">
                <span class="sc-list__icon" aria-hidden="true">
                    <i class="bi @TiposDeArquivo.Icone(documento.NomeArquivo)"></i>
                </span>
                <div class="sc-list__text">
                    <p class="sc-list__title">@documento.Titulo</p>
                    <span class="sc-list__sub">
                        <span class="sc-meta">@Tamanho(documento.Tamanho) · @documento.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                        <partial name="_Badge" model="badge" />
                    </span>
                    @if (documento.Descricao is not null)
                    {
                        <p class="mb-0 mt-1 text-body-secondary small">@documento.Descricao</p>
                    }
                </div>
                <div class="sc-list__actions d-flex gap-1">
                    <a class="btn btn-outline-secondary btn-sm"
                       asp-controller="Documentos" asp-action="Download" asp-route-id="@documento.Id">
                        <i class="bi bi-download" aria-hidden="true"></i>
                        <span class="visually-hidden">Baixar @documento.Titulo</span>
                    </a>
                    @if (Model.PodePublicar)
                    {
                        <form method="post" asp-action="Arquivar"
                              asp-route-slug="@Model.Setor.Slug" asp-route-id="@documento.Id">
                            <button class="btn btn-outline-secondary btn-sm" type="submit"
                                    title="Arquivar @documento.Titulo">
                                <i class="bi bi-archive" aria-hidden="true"></i>
                                <span class="visually-hidden">Arquivar @documento.Titulo</span>
                            </button>
                        </form>
                    }
                </div>
            </li>
        }
    </ul>
}
