@using Secco.Intranet.Web.Models.Links
@model LinkFormPaginaViewModel
@{
	var editando = Model.Id is not null;
	var titulo = (editando, Model.EhGrupo) switch
	{
		(false, _) => "Novo link",
		(true, true) => "Editar grupo",
		_ => "Editar link",
	};

	ViewData["Title"] = $"{titulo} · {Model.Setor.Nome}";

	var cabecalho = new PageHeaderModel(titulo, Model.Trilho, Model.Setor.Slug);
}

<partial name="_PageHeader" model="cabecalho" />

<div class="sc-panel mb-3">
	<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

	<form method="post"
		  asp-controller="Links"
		  asp-action="@(editando ? "Editar" : "Novo")"
		  asp-route-slug="@Model.Setor.Slug"
		  asp-route-id="@Model.Id">
		<div class="row g-3">
			<div class="col-md-8">
				<label class="form-label" asp-for="Form.Nome">Nome</label>
				<input class="form-control" asp-for="Form.Nome" autocomplete="off" />
				<span class="text-danger" asp-validation-for="Form.Nome"></span>
			</div>

			@if (!Model.EhGrupo)
			{
				<div class="col-12">
					<label class="form-label" asp-for="Form.Rota">Endereço</label>
					<input class="form-control" asp-for="Form.Rota" autocomplete="off" />
					<span class="text-danger" asp-validation-for="Form.Rota"></span>
					<div class="form-text">Um endereço completo (https://…) ou um caminho do próprio site, começando por /.</div>
				</div>

				<div class="col-md-6">
					<label class="form-label" asp-for="Form.GrupoId">Grupo</label>
					<select class="form-select" asp-for="Form.GrupoId">
						<option value="">Sem grupo</option>
						@foreach (var grupo in Model.Grupos)
						{
							<option value="@grupo.Id" selected="@(grupo.Id == Model.Form.GrupoId)">@grupo.Nome</option>
						}
					</select>
				</div>

				<div class="col-md-6 d-flex align-items-end">
					<div class="form-check">
						<input class="form-check-input" type="checkbox" asp-for="Form.NovaAba" />
						<label class="form-check-label" asp-for="Form.NovaAba">Abrir em nova página</label>
					</div>
				</div>
			}
		</div>

		<div class="sc-form__actions">
			<button class="btn btn-primary" type="submit">Salvar</button>
			<a class="btn btn-outline-secondary"
			   asp-controller="Links" asp-action="Index" asp-route-slug="@Model.Setor.Slug">Cancelar</a>
		</div>
	</form>
</div>
