@using Secco.Intranet.Domain
@using Secco.Intranet.Web.Models.Documentos
@model EditarDocumentoViewModel
@{
	ViewData["Title"] = $"Editar · {Model.Form.Titulo} · {Model.Setor.Nome}";

	var cabecalho = new PageHeaderModel(
		Model.EhGrupo ? "Editar grupo" : "Editar documento",
		"Altere os dados" + (Model.EhGrupo ? string.Empty : " ou troque o arquivo") + ". A posição na lista não muda.",
		Model.Setor.Slug,
		new[] { new PageActionModel("Voltar", Model.UrlDeVolta, "bi-arrow-left") });
}

<partial name="_PageHeader" model="cabecalho" />

<div class="sc-panel mb-3">
	<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

	<form method="post" asp-action="EditarDocumento" asp-route-slug="@Model.Setor.Slug" asp-route-id="@Model.Id" enctype="multipart/form-data">
		<div class="row g-3">
			<div class="col-md-6">
				<label class="form-label" asp-for="Form.Titulo">Título</label>
				<input class="form-control" asp-for="Form.Titulo" autocomplete="off" />
				<span class="text-danger" asp-validation-for="Form.Titulo"></span>
			</div>

			<div class="col-md-6">
				<label class="form-label" asp-for="Form.Descricao">Descrição</label>
				<input class="form-control" asp-for="Form.Descricao" autocomplete="off" />
			</div>

			@if (!Model.EhGrupo)
			{
				<div class="col-md-6">
					<label class="form-label" asp-for="Form.Visibilidade">Quem pode ver</label>
					<select class="form-select" asp-for="Form.Visibilidade">
						<option value="@((int)Visibilidade.Setor)">Somente este setor</option>
						<option value="@((int)Visibilidade.Empresa)">Toda a empresa</option>
					</select>
				</div>

				<div class="col-md-6">
					<label class="form-label" for="arquivo">Novo arquivo</label>
					<input class="form-control" type="file" id="arquivo" name="arquivo"
						   data-confirmar="O arquivo atual &quot;@Model.NomeArquivoAtual&quot; será substituído e apagado. Não dá para desfazer. Continuar?" />
					<div class="form-text">Arquivo atual: @Model.NomeArquivoAtual. Deixe em branco para manter.</div>
				</div>
			}
		</div>

		<div class="sc-form__actions">
			<button class="btn btn-primary" type="submit">Salvar</button>
			<a class="btn btn-outline-secondary" href="@Model.UrlDeVolta">Cancelar</a>
		</div>
	</form>
</div>
