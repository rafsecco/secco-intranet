@model TenantsAcessoPerfilViewModel
@{
    var tenant = Model.Tenant;
    var tela = Model.Tela;
    var perfil = tela.Perfil;
    var raiz = $"/tenants/{tenant.TenantId}/acesso";
    var raizDoPerfil = $"{raiz}/perfis/{Uri.EscapeDataString(perfil.Nome)}";

    ViewData["Title"] = $"{perfil.Nome} — {tenant.Sistema}";

    var cabecalho = new PageHeaderModel(
        perfil.Nome,
        $"Perfil de {tenant.Sistema}",
        Acoes: new[] { new PageActionModel("Voltar", raiz, "bi-arrow-left") });

    string PaginaUrl(int pagina) => $"{raizDoPerfil}?page={pagina}";

    var paginacao = new PaginationModel(
        tela.Membros.Pagina,
        tela.Membros.TotalDePaginas,
        tela.Membros.Pagina > 1 ? PaginaUrl(tela.Membros.Pagina - 1) : null,
        tela.Membros.Pagina < tela.Membros.TotalDePaginas ? PaginaUrl(tela.Membros.Pagina + 1) : null);

    static BadgeModel BadgeDaSituacao(SituacaoDoUsuario situacao) => situacao switch
    {
        SituacaoDoUsuario.Ativo => new BadgeModel("Ativo", BadgeVariante.Sucesso),
        SituacaoDoUsuario.Desativado => new BadgeModel("Desativado", BadgeVariante.Perigo),
        SituacaoDoUsuario.Bloqueado => new BadgeModel("Bloqueado", BadgeVariante.Aviso),
        _ => new BadgeModel("Desconhecida", BadgeVariante.Neutro),
    };
}

<partial name="_PageHeader" model="cabecalho" />

<div class="sc-panel">
    <h2 class="h6">Permissões</h2>
    @if (perfil.Reservado)
    {
        <p class="text-muted mb-0">Perfil reservado da plataforma — permissões não editáveis por aqui.</p>
    }
    else
    {
        var atuais = perfil.Permissoes.ToHashSet(StringComparer.Ordinal);
        var indice = 0;

        <form method="post" action="@raizDoPerfil/permissoes">
            @Html.AntiForgeryToken()
            @if (tela.Catalogo.Count == 0)
            {
                <p class="text-muted">Nenhum sistema publicou permissões no catálogo do SecureGate ainda.</p>
            }
            @foreach (var produto in tela.Catalogo)
            {
                <fieldset class="mb-3">
                    <legend class="h6 text-body-secondary">@produto.Produto</legend>
                    @foreach (var permissao in produto.Permissoes.Where(p => !p.Familia))
                    {
                        var id = $"perm-{indice++}";
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="permissoes" value="@permissao.Nome" id="@id" checked="@atuais.Contains(permissao.Nome)" />
                            <label class="form-check-label" for="@id">@permissao.Descricao <span class="sc-meta">@permissao.Nome</span></label>
                        </div>
                    }
                    @foreach (var familia in produto.Permissoes.Where(p => p.Familia))
                    {
                        <p class="form-text mb-1">
                            @familia.Descricao <span class="sc-meta">@familia.Nome</span> —
                            uma por item do próprio sistema, concedida por ele mesmo.
                        </p>
                    }
                </fieldset>
            }

            @if (perfil.PermissoesForaDoCatalogo.Count > 0)
            {
                <fieldset class="mb-3">
                    <legend class="h6">Fora do catálogo <partial name="_Badge" model="@(new BadgeModel("Sem efeito", BadgeVariante.Aviso))" /></legend>
                    <p class="form-text mt-0">Nenhum sistema declara estas permissões, então elas não concedem nada. Desmarque para retirá-las do perfil.</p>
                    @foreach (var orfa in perfil.PermissoesForaDoCatalogo)
                    {
                        var id = $"perm-{indice++}";
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="permissoes" value="@orfa" id="@id" checked />
                            <label class="form-check-label" for="@id"><span class="sc-meta">@orfa</span></label>
                        </div>
                    }
                </fieldset>
            }

            <button class="btn btn-outline-primary" type="submit">Salvar permissões</button>
        </form>
    }
</div>

<div class="sc-panel mt-3">
    <h2 class="h6">Membros (@perfil.TotalDeMembros)</h2>

    @if (tela.Membros.Itens.Count == 0)
    {
        <partial name="_EmptyState" model="@(new EmptyStateModel("bi-people", "Ninguém tem este perfil ainda"))" />
    }
    else
    {
        <ul class="sc-list">
            @foreach (var membro in tela.Membros.Itens)
            {
                <li class="sc-list__item">
                    <div class="sc-list__text">
                        <p class="sc-list__title">
                            <a class="text-reset text-decoration-none" href="@raiz/usuarios/@membro.UsuarioId">@(string.IsNullOrWhiteSpace(membro.Email) ? "(sem e-mail)" : membro.Email)</a>
                        </p>
                        <span class="sc-list__sub"><partial name="_Badge" model="BadgeDaSituacao(membro.Situacao)" /></span>
                    </div>
                    @if (!perfil.Reservado)
                    {
                        <form method="post" action="@raiz/usuarios/@membro.UsuarioId/perfis/retirar" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="perfil" value="@perfil.Nome" />
                            <input type="hidden" name="origem" value="perfil" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Retirar</button>
                        </form>
                    }
                </li>
            }
        </ul>

        <partial name="_Pagination" model="paginacao" />
    }
</div>

@if (!perfil.Reservado)
{
    <div class="sc-panel mt-3">
        @if (tela.Candidatos.Count == 0)
        {
            <p class="text-muted mb-0">Toda pessoa ativa já tem este perfil.</p>
        }
        else
        {
            <form method="post" action="@raizDoPerfil/membros" class="d-flex flex-wrap gap-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="sc-form__field mb-0">
                    <label class="form-label" for="usuarioId">Adicionar membro</label>
                    <select class="form-select" id="usuarioId" name="usuarioId" required>
                        <option value="">Escolha uma pessoa</option>
                        @foreach (var candidato in tela.Candidatos)
                        {
                            <option value="@candidato.Id">@(string.IsNullOrWhiteSpace(candidato.Email) ? candidato.Id.ToString() : candidato.Email)</option>
                        }
                    </select>
                </div>
                <button class="btn btn-outline-primary" type="submit">Adicionar</button>
            </form>
        }
    </div>

    <div class="sc-panel mt-3">
        <form method="post" action="@raizDoPerfil/excluir" data-confirmar="Excluir o perfil &quot;@perfil.Nome&quot;? Não dá para desfazer.">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-danger" type="submit">Excluir perfil</button>
            <div class="form-text">Só é possível quando o perfil não tem membros.</div>
        </form>
    </div>
}
