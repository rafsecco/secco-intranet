@model SetorFormViewModel
@{
    ViewData["Title"] = "Novo setor";

    var cabecalho = new PageHeaderModel(
        "Novo setor",
        "O slug vira a base dos perfis de acesso e do endereço do setor.");
}

<partial name="_PageHeader" model="cabecalho" />

<div class="sc-panel sc-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <form method="post" asp-action="Create">
        <div class="sc-form__field">
            <label class="form-label" asp-for="Nome">Nome</label>
            <input class="form-control" asp-for="Nome" autocomplete="off" />
            <span class="text-danger" asp-validation-for="Nome"></span>
        </div>

        <div class="sc-form__field">
            <label class="form-label" asp-for="Slug">Slug</label>
            <input class="form-control font-monospace" asp-for="Slug" autocomplete="off" />
            <div class="form-text">Minúsculas, sem espaços. Exemplo: recursos-humanos.</div>
            <span class="text-danger" asp-validation-for="Slug"></span>
        </div>

        <div class="form-check">
            <input class="form-check-input" asp-for="Fixo" />
            <label class="form-check-label" asp-for="Fixo">Setor fixo do sistema</label>
            <div class="form-text">Setores fixos não podem ser desativados nem excluídos.</div>
        </div>

        <div class="sc-form__actions">
            <button class="btn btn-primary" type="submit">Cadastrar setor</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>
