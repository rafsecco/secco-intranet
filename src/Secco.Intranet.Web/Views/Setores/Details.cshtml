@model SetorDto
@{
    ViewData["Title"] = Model.Nome;

    var cabecalho = new PageHeaderModel(
        Model.Nome,
        $"Perfis de acesso: {Model.Slug}-admin e {Model.Slug}-user.",
        Model.Slug,
        new[]
        {
            new PageActionModel("Editar", Url.Action("Edit", new { id = Model.Id })!, "bi-pencil", Primaria: true),
            new PageActionModel("Voltar para setores", Url.Action("Index")!, "bi-arrow-left"),
        });

    var situacao = Model.Ativo
        ? new BadgeModel("Ativo", BadgeVariante.Sucesso)
        : new BadgeModel("Inativo", BadgeVariante.Aviso);
}

<partial name="_PageHeader" model="cabecalho" />

<div class="sc-panel">
    <dl class="row mb-0">
        <dt class="col-sm-3">Slug</dt>
        <dd class="col-sm-9"><span class="sc-meta">@Model.Slug</span></dd>

        <dt class="col-sm-3">Ícone do menu</dt>
        <dd class="col-sm-9">
            <i class="bi @Model.Icone" aria-hidden="true"></i>
            <span class="sc-meta ms-1">@Model.Icone</span>
        </dd>

        <dt class="col-sm-3">Setor fixo</dt>
        <dd class="col-sm-9">@(Model.Fixo ? "Sim, não pode ser desativado" : "Não")</dd>

        <dt class="col-sm-3">Situação</dt>
        <dd class="col-sm-9"><partial name="_Badge" model="situacao" /></dd>

        <dt class="col-sm-3">Criado em</dt>
        <dd class="col-sm-9 mb-0"><span class="sc-meta">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span></dd>
    </dl>
</div>
