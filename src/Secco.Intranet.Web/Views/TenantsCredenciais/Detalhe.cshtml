@model TenantsCredenciaisDetalheViewModel
@{
    var tenant = Model.Tenant;
    var credencial = Model.Credencial;
    var login = credencial.Tipo == TipoDeCredencial.Login;
    var raiz = $"/tenants/{tenant.TenantId}/credenciais/{credencial.ClientId}";

    ViewData["Title"] = $"{credencial.Nome} — {tenant.Sistema}";

    var cabecalho = new PageHeaderModel(
        credencial.Nome,
        $"Credencial de {tenant.Sistema}.",
        Acoes: new[] { new PageActionModel("Voltar", $"/tenants/{tenant.TenantId}/credenciais", "bi-arrow-left") });

    var formulario = new FormularioDaCredencialViewModel(
        Model.Opcoes, credencial.Tipo, Model.Campos, raiz, "Salvar alterações", TipoNoCorpo: false, PerfisAtuais: credencial.Perfis);

    static string NomeDoEscopo(string escopo) =>
        RecursosDaPlataforma.TentarLer(escopo, out var recurso) ? RecursosDaPlataforma.Nome(recurso) : escopo;
}

<partial name="_PageHeader" model="cabecalho" />

<div class="sc-panel mb-4">
    <dl class="row mb-0">
        <dt class="col-sm-3">Client id</dt>
        <dd class="col-sm-9"><code>@credencial.ClientId</code></dd>

        <dt class="col-sm-3">Tipo</dt>
        <dd class="col-sm-9"><partial name="_Badge" model="@(login ? new BadgeModel("Login de pessoas", BadgeVariante.Sucesso) : new BadgeModel("Máquina", BadgeVariante.Neutro))" /></dd>

        <dt class="col-sm-3">Recursos</dt>
        <dd class="col-sm-9">@(credencial.Escopos.Count == 0 ? "Nenhum" : string.Join(", ", credencial.Escopos.Select(NomeDoEscopo)))</dd>

        @if (login)
        {
            <dt class="col-sm-3">Retorno do login</dt>
            <dd class="col-sm-9">@foreach (var uri in credencial.RedirectUris) { <div><code>@uri</code></div> }</dd>

            <dt class="col-sm-3">Retorno do logout</dt>
            <dd class="col-sm-9">
                @if (credencial.RedirectUrisDeLogout.Count == 0) { <span class="text-body-secondary">Nenhum</span> }
                @foreach (var uri in credencial.RedirectUrisDeLogout) { <div><code>@uri</code></div> }
            </dd>
        }
        else
        {
            <dt class="col-sm-3">Perfis</dt>
            <dd class="col-sm-9">@(credencial.Perfis.Count == 0 ? "Nenhum" : string.Join(", ", credencial.Perfis))</dd>
        }

        <dt class="col-sm-3">Emitida em</dt>
        <dd class="col-sm-9">@(credencial.CriadaEm is { } criada ? criada.ToLocalTime().ToString("g") : "—")</dd>
    </dl>
</div>

<h2 class="h5">Alterar</h2>
<partial name="_Formulario" model="formulario" />

<h2 class="h5 mt-4">Rotacionar o secret</h2>
<form method="post" action="@raiz/rotacionar" class="sc-panel" style="max-width: 40rem"
      onsubmit="return confirm('Rotacionar o secret? O secret atual deixa de valer e o sistema para de obter token até receber o secret novo.');">
    @Html.AntiForgeryToken()
    <p>Gera um secret novo e invalida o atual: o sistema para de obter token até receber o secret novo. O secret novo aparece uma única vez.</p>
    <button class="btn btn-outline-primary" type="submit">Rotacionar</button>
</form>

<h2 class="h5 mt-4">Revogar</h2>
<form method="post" action="@raiz/revogar" class="sc-panel" style="max-width: 40rem">
    @Html.AntiForgeryToken()
    <p>Revogar apaga a credencial; tokens já emitidos valem até 5 minutos. Para confirmar, digite o nome <code>@credencial.Nome</code>.</p>
    <div class="input-group">
        <input class="form-control" name="confirmacao" aria-label="Nome da credencial para confirmar" autocomplete="off" required />
        <button class="btn btn-outline-danger" type="submit">Revogar</button>
    </div>
</form>
