@model TenantsCredenciaisSecretViewModel
@{
    var tenant = Model.Tenant;
    var titulo = Model.Rotacao ? "Secret novo" : "Credencial emitida";

    ViewData["Title"] = $"{titulo} — {tenant.Sistema}";

    var cabecalho = new PageHeaderModel(titulo, $"Credencial de {tenant.Sistema}.");

    var variaveis = string.Join('\n',
        $"Secco__SecureGate__Authority={Model.Authority}",
        $"Secco__SecureGate__ClientId={Model.Secret.ClientId}",
        $"Secco__SecureGate__ClientSecret={Model.Secret.Valor}");
}

<partial name="_PageHeader" model="cabecalho" />

<div class="alert alert-warning" role="alert">
    <strong>Copie agora: o secret não aparece de novo.</strong> Entregue ao time do sistema pelo cofre, nunca por e-mail ou repositório.
    @if (Model.Rotacao)
    {
        <span>O secret anterior já não vale.</span>
    }
</div>

<div class="sc-panel mb-3">
    <dl class="row mb-0">
        <dt class="col-sm-3">Client id</dt>
        <dd class="col-sm-9"><code>@Model.Secret.ClientId</code></dd>

        <dt class="col-sm-3">Secret</dt>
        <dd class="col-sm-9"><code>@Model.Secret.Valor</code></dd>

        <dt class="col-sm-3">Authority</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Authority) ? "(não configurada nesta Intranet)" : Model.Authority)</dd>
    </dl>
</div>

<h2 class="h5">Variáveis de ambiente</h2>
<pre class="sc-panel" style="white-space: pre-wrap"><code>@variaveis</code></pre>

<a class="btn btn-primary" href="/tenants/@tenant.TenantId/credenciais">Voltar às credenciais</a>
