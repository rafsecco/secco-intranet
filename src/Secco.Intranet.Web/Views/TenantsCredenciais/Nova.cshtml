@model TenantsCredenciaisNovaViewModel
@{
    var tenant = Model.Tenant;
    var login = Model.Tipo == TipoDeCredencial.Login;
    var titulo = login ? "Emitir credencial de login" : "Emitir credencial de máquina";

    ViewData["Title"] = $"{titulo} — {tenant.Sistema}";

    var cabecalho = new PageHeaderModel(
        titulo,
        login
            ? $"Para um sistema de {tenant.Sistema} que entra pessoas pelo SecureGate."
            : $"Para um sistema de {tenant.Sistema} falar com a plataforma, sem pessoa no meio.",
        Acoes: new[] { new PageActionModel("Voltar", $"/tenants/{tenant.TenantId}/credenciais", "bi-arrow-left") });

    var formulario = new FormularioDaCredencialViewModel(
        Model.Opcoes, Model.Tipo, Model.Campos, $"/tenants/{tenant.TenantId}/credenciais/nova", "Emitir", TipoNoCorpo: true, PerfisAtuais: []);
}

<partial name="_PageHeader" model="cabecalho" />

@if (Model.Erro is { } erro)
{
    <div class="alert alert-danger" role="alert">@erro</div>
}

@if (login && !Model.Opcoes.SecureGateLigado)
{
    <div class="alert alert-warning" role="alert">
        Ligue o SecureGate do tenant para emitir uma credencial de login: é por ele que as pessoas entram.
    </div>
}
else
{
    <partial name="_Formulario" model="formulario" />
}
