@model TenantsCredenciaisIndexViewModel
@{
    var tenant = Model.Tenant;
    var raiz = $"/tenants/{tenant.TenantId}/credenciais";

    ViewData["Title"] = $"Credenciais — {tenant.Sistema}";

    var cabecalho = new PageHeaderModel(
        tenant.Sistema,
        $"Credenciais OAuth do tenant {tenant.Nome}: como os sistemas se identificam no SecureGate.",
        Acoes: new[]
        {
            new PageActionModel("Voltar ao tenant", $"/tenants/{tenant.TenantId}", "bi-arrow-left"),
            new PageActionModel("Emitir credencial de máquina", $"{raiz}/nova?tipo=maquina", "bi-cpu"),
            new PageActionModel("Emitir credencial de login", $"{raiz}/nova?tipo=login", "bi-box-arrow-in-right"),
        });

    static string NomeDoEscopo(string escopo) =>
        RecursosDaPlataforma.TentarLer(escopo, out var recurso) ? RecursosDaPlataforma.Nome(recurso) : escopo;
}

<partial name="_PageHeader" model="cabecalho" />

@if (!tenant.Ativo)
{
    <p><partial name="_Badge" model="@(new BadgeModel("Tenant desativado", BadgeVariante.Aviso))" /> <span class="text-body-secondary">A plataforma não emite credencial para um tenant desativado.</span></p>
}

@if (Model.Credenciais.Count == 0)
{
    <partial name="_EmptyState" model="@(new EmptyStateModel("bi-key", "Nenhuma credencial ainda", "Emita uma credencial de máquina ou de login para o sistema se identificar."))" />
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Nome</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Client id</th>
                    <th scope="col">Escopos</th>
                    <th scope="col">Emitida em</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var credencial in Model.Credenciais)
                {
                    <tr>
                        <th scope="row"><a class="text-reset" href="@raiz/@credencial.ClientId">@credencial.Nome</a></th>
                        <td>
                            <partial name="_Badge" model="@(credencial.Tipo == TipoDeCredencial.Login ? new BadgeModel("Login de pessoas", BadgeVariante.Sucesso) : new BadgeModel("Máquina", BadgeVariante.Neutro))" />
                        </td>
                        <td><code>@credencial.ClientId</code></td>
                        <td>@string.Join(", ", credencial.Escopos.Select(NomeDoEscopo))</td>
                        <td class="sc-meta">@(credencial.CriadaEm is { } criada ? criada.ToLocalTime().ToString("dd/MM/yyyy") : "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
