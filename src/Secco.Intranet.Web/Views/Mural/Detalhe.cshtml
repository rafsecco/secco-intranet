@using Secco.Intranet.Domain.Publicacoes
@using Secco.Intranet.Web.Models.Mural
@model PublicacaoDetalheViewModel
@{
    var publicacao = Model.Publicacao;

    ViewData["Title"] = publicacao.Titulo;

    static string Rotulo(TipoPublicacao tipo) => tipo switch
    {
        TipoPublicacao.Aviso => "Aviso",
        TipoPublicacao.Evento => "Evento",
        _ => "Notícia",
    };

    var voltar = new PageActionModel("Voltar ao mural", Url.Action("Index", "Mural")!, "bi-arrow-left");

    var cabecalho = new PageHeaderModel(
        publicacao.Titulo,
        $"{Rotulo(publicacao.Tipo)} · {publicacao.PublicadoEm.ToLocalTime():dd/MM/yyyy}",
        publicacao.SetorSlug,
        new[] { voltar });

    var badgeDoSetor = new BadgeModel(publicacao.SetorNome, BadgeVariante.Setor, publicacao.SetorSlug);

    // O corpo NÃO usa o _Card: o card repete título e meta, que é útil numa listagem — onde o
    // título distingue um item entre muitos — e vira duplicata numa página que já tem
    // cabeçalho próprio.
    var classes = publicacao.Prioridade == PrioridadePublicacao.Urgente
        ? "sc-panel sc-urgente"
        : "sc-panel";
}

<partial name="_PageHeader" model="cabecalho" />

<article class="@classes" style="--sc-setor-hue:@SetorHue.From(publicacao.SetorSlug)">
    <partial name="_Badge" model="badgeDoSetor" />

    <div class="sc-card__body mt-2">@publicacao.Corpo</div>
</article>
