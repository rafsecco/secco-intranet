@using Secco.Intranet.Domain.Publicacoes
@using Secco.Intranet.Web.Models.Mural
@model MuralViewModel
@{
    ViewData["Title"] = "Mural";

    static string Rotulo(TipoPublicacao tipo) => tipo switch
    {
        TipoPublicacao.Aviso => "Aviso",
        TipoPublicacao.Evento => "Evento",
        _ => "Notícia",
    };

    string? PaginaUrl(int pagina) => Url.Action("Index", new { tipo = Model.Filtro, page = pagina });

    var cabecalho = new PageHeaderModel(
        "Mural",
        "Comunicados, eventos e notícias dos setores da empresa.");

    var abas = new (string Texto, TipoPublicacao? Tipo)[]
    {
        ("Tudo", null),
        ("Avisos", TipoPublicacao.Aviso),
        ("Eventos", TipoPublicacao.Evento),
        ("Notícias", TipoPublicacao.Noticia),
    };

    var vazio = Model.Filtro is null
        ? new EmptyStateModel(
            "bi-megaphone",
            "O mural ainda não tem publicações",
            "Publicações feitas pelos setores aparecem aqui, da mais recente para a mais antiga.")
        : new EmptyStateModel(
            "bi-funnel",
            "Nenhuma publicação com esse filtro",
            "Escolha outro tipo para ver o restante do conteúdo.");

    var paginacao = new PaginationModel(
        Model.Pagina.Page,
        Model.Pagina.TotalPages,
        Model.Pagina.HasPreviousPage ? PaginaUrl(Model.Pagina.Page - 1) : null,
        Model.Pagina.HasNextPage ? PaginaUrl(Model.Pagina.Page + 1) : null);
}

<partial name="_PageHeader" model="cabecalho" />

<nav class="sc-tabs" aria-label="Filtrar por tipo">
    @foreach (var aba in abas)
    {
        <a class="sc-tabs__item @(Model.Filtro == aba.Tipo ? "is-active" : null)"
           asp-action="Index"
           asp-route-tipo="@aba.Tipo"
           aria-current="@(Model.Filtro == aba.Tipo ? "page" : null)">@aba.Texto</a>
    }
</nav>

@if (Model.Pagina.Items.Count == 0)
{
    <partial name="_EmptyState" model="vazio" />
}
else
{
    <div class="sc-stack">
        @foreach (var publicacao in Model.Pagina.Items)
        {
            var urgente = publicacao.Prioridade == PrioridadePublicacao.Urgente;

            var card = new CardModel(
                Titulo: publicacao.Titulo,
                Meta: $"{Rotulo(publicacao.Tipo)} · {publicacao.PublicadoEm.ToLocalTime():dd/MM/yyyy}",
                SetorSlug: publicacao.SetorSlug,
                SetorNome: publicacao.SetorNome,
                Corpo: publicacao.Corpo);

            if (urgente)
            {
                <div class="sc-urgente">
                    <partial name="_Card" model="card" />
                </div>
            }
            else
            {
                <partial name="_Card" model="card" />
            }
        }
    </div>

    <partial name="_Pagination" model="paginacao" />
}
