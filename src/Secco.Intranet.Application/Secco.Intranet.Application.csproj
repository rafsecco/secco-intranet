<Project Sdk="Microsoft.NET.Sdk">

  <!-- Application (ADR-0002): casos de uso e portas; retorna Result<T>.
       Dependências externas: abstrações de DI e de logging e o Markdig — todas puras, sem I/O.
       O Markdig entra porque o resumo enviado na notificação é texto puro extraído do
       corpo em Markdown, e transformar texto é regra do caso de uso, não da borda. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Secco.Intranet.Domain\Secco.Intranet.Domain.csproj" />
  </ItemGroup>

  <!-- As regras puras do aviso (AvisoDeVencimento) sao internal, mas precisam de teste
       direto: lotes e destinatarios sao onde um erro silencioso manda aviso a quem nao deve. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Secco.Intranet.Tests" />
  </ItemGroup>

</Project>
