<Project Sdk="Microsoft.NET.Sdk">

  <!-- Infrastructure (ADR-0002): EF Core + implementações de portas.
       Dois providers suportados (ADR-0018): SQL Server (padrão) e PostgreSQL;
       migrations vivem em assemblies próprios por engine. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Repositório standalone: SDK da plataforma via pacotes NuGet do feed privado -->
    <PackageReference Include="Secco.SDK.EntityFrameworkCore" />
    <!-- Tenancy (ITenantConnectionFactory/ITenantCatalog) vive no SDK.AspNetCore (ADR-0004/0005) -->
    <PackageReference Include="Secco.SDK.AspNetCore" />
    <!-- Client administrativo do SecureGate: provisionamento das Roles de setor (ADR-0001) -->
    <PackageReference Include="Secco.SecureGate.Client" />
    <PackageReference Include="Secco.NotificationHub.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Secco.Intranet.Application\Secco.Intranet.Application.csproj" />
  </ItemGroup>

  <!-- A cifragem em envelope e o armazenamento sao detalhes internos, mas precisam de teste
       direto: sao o tipo de codigo em que um erro silencioso custa caro. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Secco.Intranet.Tests" />
  </ItemGroup>

</Project>
