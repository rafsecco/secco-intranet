<Project Sdk="Microsoft.NET.Sdk">

  <!-- Contrato de extensão do menu principal (mesmo raciocínio da ADR-0004 para o Theming): o
       único projeto que uma RCL externa precisa referenciar para acrescentar itens ao menu.
       Deliberadamente sem dependência de Secco.Intranet.Web nem de nenhum outro projeto do
       produto — é o que quebra o ciclo, já que a Web referencia as RCLs externas. Só o BCL e o
       framework compartilhado do ASP.NET (DependencyInjection.Abstractions vem nele). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
