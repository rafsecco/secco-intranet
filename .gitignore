# Gitignore para repositório Secco.Intranet
# Baseado em VisualStudio official template, adaptado para .NET 9 Clean Architecture

# ============================================================================
# BUILD E ARTEFATOS
# ============================================================================
bin/
obj/
artifacts/
[Dd]ebug/
[Rr]elease/
out/

# ============================================================================
# VISUAL STUDIO
# ============================================================================
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# ============================================================================
# RIDER / INTELLIJ
# ============================================================================
.idea/
*.sln.iml

# ============================================================================
# VISUAL STUDIO CODE
# ============================================================================
# Ignorar toda pasta .vscode
.vscode/*

# Exceção: o template É versionado. Padrão sem barra casa em qualquer profundidade,
# e a negação vem DEPOIS — invertida, o .env.* acima reignoraria o template.
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ============================================================================
# TESTES E COBERTURA DE CÓDIGO
# ============================================================================
TestResults/
coverage*/
*.trx
*.coverage
*.coveragexml

# ============================================================================
# NUGET
# ============================================================================
*.nupkg
*.snupkg
packages/
project.lock.json

# ============================================================================
# PUBLICAÇÃO E DEPLOY
# ============================================================================
publish/
*.pubxml.user
# Nota: não ignorar *.pubxml em si, apenas *.pubxml.user (arquivo local)

# ============================================================================
# SEGREDOS LOCAIS (NÃO VERSIONADOS)
# ============================================================================
appsettings.*.local.json
*.env
.env
.env.*
# Exceção: o template É versionado. Padrão sem barra casa em qualquer profundidade,
# e a negação vem DEPOIS — invertida, o .env.* acima reignoraria o template.
!.env.example
secrets.json
# Nota: appsettings.json e appsettings.Development.json SÃO versionados

# ============================================================================
# BANCO DE DADOS LOCAL
# ============================================================================
*.db
*.db-shm
*.db-wal
*.mdf
*.ldf

# ============================================================================
# SISTEMA OPERACIONAL
# ============================================================================
Thumbs.db
Desktop.ini
.DS_Store

# ============================================================================
# LOGS
# ============================================================================
*.log
logs/

# ============================================================================
# NOTA: .claude/ É VERSIONADO
# ============================================================================
# A pasta .claude/ contém configurações e deve ser versionada no repositório

# Dependencias de build de assets dos temas (o CSS compilado e versionado)
node_modules/

# Saida de verificacao manual no navegador (screenshots, snapshots de acessibilidade) —
# nunca e para versionar, e um `git add -A` distraido ja pegou isso uma vez.
.playwright-mcp/

# Rascunho do subagent-driven-development: ledger, briefs e pacotes de revisao.
# O registro definitivo e o historico do git.
.superpowers/
