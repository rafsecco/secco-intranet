<Project>

  <!-- Central Package Management: toda versão de pacote da solução é declarada aqui.
       Os .csproj usam PackageReference sem atributo Version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Secco Platform (feed privado — versões conforme tags MinVer do monorepo)">
    <PackageVersion Include="Secco.SharedKernel" Version="0.3.3" />
    <PackageVersion Include="Secco.SDK.AspNetCore" Version="0.4.1" />
    <!-- O feed tem 0.2.0 desde 2026-07-12. Mantida em 0.1.0 até alguém verificar o que
         mudou entre as duas: o changelog do monorepo só descreve versões a partir de
         2026-08-30, e este é o pacote do SeccoDbContext e da convention de nomenclatura. -->
    <PackageVersion Include="Secco.SDK.EntityFrameworkCore" Version="0.1.0" />
    <!-- 0.2.1 e não 0.2.0: o 0.2.0 foi empacotado com dependências prerelease não
         publicadas (regra "tag estável exige tag da dependência no mesmo commit" do
         monorepo); o 0.2.1 é o mesmo código, republicado contra as dependências estáveis -->
    <PackageVersion Include="Secco.SecureGate.Client" Version="0.2.1" />
  </ItemGroup>

  <ItemGroup Label="Application">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Web">
    <!-- Relying party OIDC (ADR-0023): o handler não vem implícito no FrameworkReference. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup Label="EF Core / Migrations">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Testes">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Fork do FluentAssertions (Apache 2.0 — o original 8+ exige licença comercial);
         a partir da linha 9.x o namespace passou a ser AwesomeAssertions -->
    <PackageVersion Include="AwesomeAssertions" Version="9.4.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <!-- Base das factories de integração da plataforma (ADR-0027): traz o Testcontainers
         e a instância de SQL Server, então o produto não reescreve a própria factory. -->
    <PackageVersion Include="Secco.SDK.Testing" Version="0.1.0" />
    <!-- Versão fixada para o pinning transitivo; a referência direta saiu com o SDK.Testing. -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.14.0" />
  </ItemGroup>

</Project>
