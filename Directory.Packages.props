<Project>

  <!-- Central Package Management: toda versão de pacote da solução é declarada aqui.
       Os .csproj usam PackageReference sem atributo Version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Secco Platform (feed privado — versões conforme tags MinVer do monorepo)">
    <PackageVersion Include="Secco.SharedKernel" Version="0.7.11" />
    <!-- 0.5.0 acrescenta SeccoAmbientContext (espelho AsyncLocal de tenant e correlação),
         que é o que permite um sink de log singleton enxergar o tenant da requisição. -->
    <PackageVersion Include="Secco.SDK.AspNetCore" Version="0.10.1" />
    <PackageVersion Include="Secco.SDK.EntityFrameworkCore" Version="0.6.0" />
    <PackageVersion Include="Secco.SDK.ClientCredentials" Version="0.1.21" />
    <!-- Sink ILogger -> LogStream. NUNCA a 0.1.0: ela foi empacotada contra o LogStream.Client
         0.2.0 e chama um metodo que a 0.3.0 renomeou; o dispatcher engole a falha por design,
         entao o sintoma e log que simplesmente nao chega. -->
    <PackageVersion Include="Secco.SDK.Logging" Version="0.2.0" />
    <PackageVersion Include="Secco.SDK.Imaging" Version="0.2.0" />
    <!-- Exportacao Excel/PDF (ADR-0058 da plataforma, ADR-0013): gravadores proprios, sem dependencia de terceiros. -->
    <PackageVersion Include="Secco.SDK.Documents" Version="0.1.0" />
    <PackageVersion Include="Secco.SecureGate.Client" Version="0.24.0" />
    <!-- 0.5.0: SearchNotifications (relatorio de entrega numa chamada) e ScheduledFor
         (entrega na entrada no ar, segurando e-mail E item do sino). -->
    <PackageVersion Include="Secco.NotificationHub.Client" Version="0.6.0" />
    <!-- audit-entries: a trilha de acao de usuario (ADR-0006). -->
    <PackageVersion Include="Secco.LogStream.Client" Version="0.5.0" />
  </ItemGroup>

  <ItemGroup Label="Application">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Web">
    <!-- Relying party OIDC (ADR-0023): o handler não vem implícito no FrameworkReference. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <!-- Markdown do mural. O pipeline desabilita HTML bruto, entao nao ha sanitizador a manter. -->
    <PackageVersion Include="Markdig" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup Label="EF Core / Migrations">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Transitivo do Microsoft.Data.SqlClient 6.1.7 (via EF Core SqlServer), que pede a 9.0.11 com
         vulnerabilidade conhecida (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). A pinagem transitiva
         central sobe para a versão corrigida; remover quando o SqlClient referenciado já trouxer uma. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Testes">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- Fork do FluentAssertions (Apache 2.0 — o original 8+ exige licença comercial);
         a partir da linha 9.x o namespace passou a ser AwesomeAssertions -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <!-- FakeTimeProvider: relógio controlável dos testes de vencimento. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <!-- Testes de tela (tests/.../Ui), opt-in por SECCO_UI_TESTS: menu e submenus num navegador real. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <!-- Base das factories de integração da plataforma (ADR-0027): traz o Testcontainers
         e a instância de SQL Server, então o produto não reescreve a própria factory. -->
    <PackageVersion Include="Secco.SDK.Testing" Version="0.1.1" />
    <!-- O SDK.Testing também o traz; os testes de migration usam o builder diretamente. -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <!-- Mesma linha do Testcontainers.MsSql: os testes de migration sobem um Postgres real. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
  </ItemGroup>

</Project>
