<Project>

  <!-- Central Package Management: toda versão de pacote da solução é declarada aqui.
       Os .csproj usam PackageReference sem atributo Version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Secco Platform (feed privado — versões conforme tags MinVer do monorepo)">
    <PackageVersion Include="Secco.SharedKernel" Version="0.3.5" />
    <!-- 0.5.0 acrescenta SeccoAmbientContext (espelho AsyncLocal de tenant e correlação),
         que é o que permite um sink de log singleton enxergar o tenant da requisição. -->
    <PackageVersion Include="Secco.SDK.AspNetCore" Version="0.5.1" />
    <PackageVersion Include="Secco.SDK.EntityFrameworkCore" Version="0.4.0" />
    <PackageVersion Include="Secco.SecureGate.Client" Version="0.3.0" />
    <!-- 0.5.0: SearchNotifications (relatorio de entrega numa chamada) e ScheduledFor
         (entrega na entrada no ar, segurando e-mail E item do sino). -->
    <PackageVersion Include="Secco.NotificationHub.Client" Version="0.5.0" />
    <!-- audit-entries: a trilha de acao de usuario (ADR-0006). -->
    <PackageVersion Include="Secco.LogStream.Client" Version="0.3.1" />
  </ItemGroup>

  <ItemGroup Label="Application">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Web">
    <!-- Relying party OIDC (ADR-0023): o handler não vem implícito no FrameworkReference. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.9" />
    <!-- Markdown do mural. O pipeline desabilita HTML bruto, entao nao ha sanitizador a manter. -->
    <PackageVersion Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup Label="EF Core / Migrations">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Testes">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Fork do FluentAssertions (Apache 2.0 — o original 8+ exige licença comercial);
         a partir da linha 9.x o namespace passou a ser AwesomeAssertions -->
    <PackageVersion Include="AwesomeAssertions" Version="9.4.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <!-- Base das factories de integração da plataforma (ADR-0027): traz o Testcontainers
         e a instância de SQL Server, então o produto não reescreve a própria factory. -->
    <PackageVersion Include="Secco.SDK.Testing" Version="0.1.0" />
    <!-- Versão fixada para o pinning transitivo; a referência direta saiu com o SDK.Testing. -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.14.0" />
  </ItemGroup>

</Project>
